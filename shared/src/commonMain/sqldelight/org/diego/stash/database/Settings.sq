CREATE TABLE reminder_settings (
    id INTEGER PRIMARY KEY,
    remind_30_days INTEGER NOT NULL DEFAULT 1,
    remind_7_days INTEGER NOT NULL DEFAULT 1,
    remind_1_day INTEGER NOT NULL DEFAULT 1
);

selectSettings:
SELECT * FROM reminder_settings WHERE id = 1;

upsertSettings:
INSERT OR REPLACE INTO reminder_settings (id, remind_30_days, remind_7_days, remind_1_day)
VALUES (?, ?, ?, ?);
